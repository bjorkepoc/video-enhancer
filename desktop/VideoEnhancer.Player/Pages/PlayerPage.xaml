<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VideoEnhancer_Player.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="PlayerLayout"
        Padding="16"
        ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="480" />
            <ColumnDefinition x:Name="EnhancerColumn" Width="360" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="PlaybackSurface" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="VideoShell"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                SizeChanged="VideoShell_SizeChanged">
                <MediaPlayerElement
                    x:Name="PlayerElement"
                    AreTransportControlsEnabled="False"
                    PointerMoved="PlayerElement_InputWhenFullWindow"
                    PointerPressed="PlayerElement_InputWhenFullWindow"
                    PointerReleased="PlayerElement_InputWhenFullWindow"
                    PointerWheelChanged="PlayerElement_InputWhenFullWindow"
                    RenderTransformOrigin="0.5,0.5"
                    Stretch="Uniform">
                    <MediaPlayerElement.RenderTransform>
                        <ScaleTransform x:Name="VideoZoomTransform" />
                    </MediaPlayerElement.RenderTransform>
                </MediaPlayerElement>
                <StackPanel
                    Margin="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        x:Name="ZoomOutButton"
                        Width="36"
                        Height="36"
                        AutomationProperties.Name="Zoom out"
                        Click="ZoomOut_Click"
                        ToolTipService.ToolTip="Zoom out">
                        <FontIcon FontSize="14" Glyph="&#xE71F;" />
                    </Button>
                    <Button
                        x:Name="ResetZoomButton"
                        Width="36"
                        Height="36"
                        AutomationProperties.Name="Reset zoom"
                        Click="ResetZoom_Click"
                        ToolTipService.ToolTip="Reset zoom">
                        <FontIcon FontSize="14" Glyph="&#xE777;" />
                    </Button>
                    <Button
                        x:Name="ZoomInButton"
                        Width="36"
                        Height="36"
                        AutomationProperties.Name="Zoom in"
                        Click="ZoomIn_Click"
                        ToolTipService.ToolTip="Zoom in">
                        <FontIcon FontSize="14" Glyph="&#xE8A3;" />
                    </Button>
                </StackPanel>
            </Grid>

            <CommandBar Grid.Row="1" DefaultLabelPosition="Collapsed" IsOpen="False">
                <AppBarButton Click="OpenVideo_Click" Label="Open">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="OpenFile" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="PlayPauseButton" Click="PlayPause_Click" Label="Play">
                    <AppBarButton.Icon>
                        <SymbolIcon Symbol="Play" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="FrameBack_Click" Label="Frame back">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE76B;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Click="FrameForward_Click" Label="Frame forward">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE76C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="FullScreenButton" Click="FullScreen_Click" Label="Full screen">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE740;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarToggleButton x:Name="SlowModeButton" Click="SlowMode_Click" Label="Step FPS">
                    <AppBarToggleButton.Icon>
                        <SymbolIcon Symbol="Clock" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarElementContainer>
                    <NumberBox
                        x:Name="StepFpsBox"
                        Width="112"
                        AutomationProperties.Name="Step playback FPS"
                        LargeChange="10"
                        Maximum="60"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        Value="1"
                        ValueChanged="StepFpsBox_ValueChanged" />
                </AppBarElementContainer>
            </CommandBar>

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Slider
                    x:Name="TimelineSlider"
                    Minimum="0"
                    ValueChanged="TimelineSlider_ValueChanged" />
                <TextBlock
                    x:Name="TimeText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="00:00 / 00:00" />
            </Grid>
        </Grid>

        <ScrollViewer x:Name="EnhancerPanel" Grid.Column="1">
            <StackPanel Spacing="14">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Enhance" />

                <InfoBar
                    x:Name="StatusInfo"
                    IsOpen="False"
                    Severity="Informational" />

                <TextBlock Text="Input" />
                <TextBox x:Name="InputPathBox" IsReadOnly="True" PlaceholderText="Open a video first" />

                <TextBlock Text="Output" />
                <TextBox x:Name="OutputPathBox" PlaceholderText="Output .mp4 path" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Preset" />
                        <ComboBox x:Name="PresetBox" SelectedIndex="3">
                            <ComboBoxItem Content="fast" />
                            <ComboBoxItem Content="balanced" />
                            <ComboBoxItem Content="quality" />
                            <ComboBoxItem Content="ultra" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Filter backend" />
                        <ComboBox x:Name="FilterBackendBox" SelectedIndex="1">
                            <ComboBoxItem Content="cpu" />
                            <ComboBoxItem Content="auto" />
                            <ComboBoxItem Content="cuda" />
                            <ComboBoxItem Content="opencl" />
                            <ComboBoxItem Content="vulkan" />
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Scale" />
                        <NumberBox x:Name="ScaleBox" Minimum="0.1" SmallChange="0.5" Value="2" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="FPS" />
                        <NumberBox x:Name="FpsBox" Minimum="1" SmallChange="1" Value="60" />
                    </StackPanel>
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="NoUpscaleBox" Content="No upscale" />
                    <CheckBox x:Name="NoInterpolateBox" Grid.Column="1" Content="No interpolation" />
                </Grid>

                <TextBlock Text="Video codec" />
                <ComboBox x:Name="CodecBox" SelectedIndex="0">
                    <ComboBoxItem Content="libx264" />
                    <ComboBoxItem Content="libx265" />
                    <ComboBoxItem Content="h264_nvenc" />
                    <ComboBoxItem Content="hevc_nvenc" />
                    <ComboBoxItem Content="av1_nvenc" />
                    <ComboBoxItem Content="h264_amf" />
                    <ComboBoxItem Content="hevc_amf" />
                    <ComboBoxItem Content="av1_amf" />
                    <ComboBoxItem Content="h264_qsv" />
                    <ComboBoxItem Content="hevc_qsv" />
                    <ComboBoxItem Content="av1_qsv" />
                </ComboBox>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="6">
                        <TextBlock Text="Quality" />
                        <NumberBox x:Name="QualityBox" Minimum="0" Maximum="51" SmallChange="1" Value="16" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock Text="Encoder preset" />
                        <TextBox x:Name="EncoderPresetBox" PlaceholderText="auto" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="OverwriteBox" Content="Overwrite output" />

                <ProgressBar
                    x:Name="EnhanceProgress"
                    Minimum="0"
                    Maximum="100"
                    Value="0" />
                <TextBlock x:Name="ProgressText" Text="Idle" TextWrapping="Wrap" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Click="DryRun_Click" Content="Dry run" />
                    <Button Grid.Column="1" Click="Enhance_Click" Content="Enhance" />
                    <Button Grid.Column="2" Click="Cancel_Click" Content="Cancel" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
